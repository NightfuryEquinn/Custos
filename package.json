{
  "name": "custos",
  "version": "4.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run lint && bun run format:check && bun test tests && bun run typecheck && bun run knip",
    "db:wipe-account": "bun scripts/wipe-account.ts",
    "db:prune-stale": "bun scripts/prune-stale-users.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "animejs": "^4.5.0",
    "ethers": "^6.17.0",
    "hono": "^4.12.28",
    "ldrs": "^1.1.9",
    "mermaid": "^11.16.0",
    "mongodb": "6.12.0",
    "react": "^19",
    "react-colorful": "^5.8.0",
    "react-dom": "^19",
    "shepherd.js": "^15.2.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^5.44.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
