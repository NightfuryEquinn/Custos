{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/vercel-api.ts",
    "src/frontend/main.tsx",
    "src/frontend/lib/search/worker.ts",
    "scripts/*.ts",
    "website/motion.ts",
    "website/theme.ts",
    "src/**/*.test.ts"
  ],
  "project": ["src/**", "scripts/**"],
  "exclude": ["duplicates"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["lint-staged"]
}
